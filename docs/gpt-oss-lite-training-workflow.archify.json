{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "GPT-OSS-Lite Pretraining Workflow",
    "locale": "en",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "compute",
      "label": "Micro-batch"
    },
    {
      "id": "commit",
      "label": "Optimizer clock"
    },
    {
      "id": "recovery",
      "label": "Recovery / exit",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "next_batch",
    "forward",
    "finite_gate",
    "backward",
    "boundary"
  ],
  "nodes": [
    {
      "id": "next_batch",
      "lane": "compute",
      "col": 0,
      "label": "Fetch Micro-batch",
      "sublabel": "8 × 4096 windows",
      "type": "backend",
      "width": 165
    },
    {
      "id": "forward",
      "lane": "compute",
      "col": 1,
      "label": "Forward + CE",
      "sublabel": "(CE + .01×aux) / 4",
      "type": "backend",
      "width": 165
    },
    {
      "id": "finite_gate",
      "lane": "compute",
      "col": 2,
      "label": "Finite Loss?",
      "sublabel": "before backward",
      "type": "security",
      "width": 165
    },
    {
      "id": "backward",
      "lane": "compute",
      "col": 3,
      "label": "Backward",
      "sublabel": "micro_step += 1",
      "type": "backend",
      "width": 165
    },
    {
      "id": "boundary",
      "lane": "commit",
      "col": 3,
      "label": "4 Micros Done?",
      "sublabel": "micro_step % 4 == 0",
      "type": "security",
      "width": 165
    },
    {
      "id": "optimizer",
      "lane": "commit",
      "col": 2,
      "label": "Optimizer Commit",
      "sublabel": "clip · AdamW · LR · step++",
      "type": "backend",
      "width": 165
    },
    {
      "id": "cadence",
      "lane": "commit",
      "col": 1,
      "label": "Cadence / Stop",
      "sublabel": "step < 61000?",
      "type": "security",
      "width": 165
    },
    {
      "id": "checkpoint",
      "lane": "commit",
      "col": 0,
      "label": "Periodic Save",
      "sublabel": "every 2000 updates",
      "type": "database",
      "width": 165
    },
    {
      "id": "reset_grads",
      "lane": "recovery",
      "col": 2,
      "label": "Discard / Restore",
      "sublabel": "clear grads + micro count",
      "type": "security",
      "width": 165
    },
    {
      "id": "abort",
      "lane": "recovery",
      "col": 3,
      "label": "Abort",
      "sublabel": "5 failures, no checkpoint",
      "type": "security",
      "width": 165
    },
    {
      "id": "final",
      "lane": "recovery",
      "col": 0,
      "label": "Final Save + RNG",
      "sublabel": "no sampler position",
      "type": "database",
      "width": 165
    }
  ],
  "edges": [
    {
      "id": "batch_forward",
      "from": "next_batch",
      "to": "forward",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "loss_gate",
      "from": "forward",
      "to": "finite_gate",
      "role": "main",
      "variant": "emphasis",
      "label": "scaled loss"
    },
    {
      "id": "finite_backward",
      "from": "finite_gate",
      "to": "backward",
      "role": "main",
      "variant": "emphasis",
      "label": "yes"
    },
    {
      "id": "backward_boundary",
      "from": "backward",
      "to": "boundary",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "boundary_commit",
      "from": "boundary",
      "to": "optimizer",
      "role": "branch",
      "variant": "emphasis",
      "label": "yes"
    },
    {
      "id": "micro_loop",
      "from": "boundary",
      "to": "next_batch",
      "role": "return",
      "variant": "dashed",
      "label": "no: next micro"
    },
    {
      "id": "commit_cadence",
      "from": "optimizer",
      "to": "cadence",
      "role": "branch",
      "variant": "emphasis"
    },
    {
      "id": "update_loop",
      "from": "cadence",
      "to": "next_batch",
      "role": "return",
      "variant": "dashed",
      "label": "continue"
    },
    {
      "id": "periodic",
      "from": "cadence",
      "to": "checkpoint",
      "role": "branch",
      "variant": "dashed",
      "label": "2000 due"
    },
    {
      "id": "saved_continue",
      "from": "checkpoint",
      "to": "next_batch",
      "role": "return",
      "variant": "dashed",
      "label": "continue"
    },
    {
      "id": "finished",
      "from": "cadence",
      "to": "final",
      "role": "branch",
      "variant": "emphasis",
      "label": "61000 reached"
    },
    {
      "id": "nonfinite",
      "from": "finite_gate",
      "to": "reset_grads",
      "role": "error",
      "variant": "security",
      "label": "no"
    },
    {
      "id": "recover",
      "from": "reset_grads",
      "to": "next_batch",
      "role": "return",
      "variant": "security",
      "label": "skip / restore latest"
    },
    {
      "id": "no_checkpoint",
      "from": "reset_grads",
      "to": "abort",
      "role": "error",
      "variant": "security",
      "label": "5 + no checkpoint"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Two clocks",
      "items": [
        "4 finite micro-batches per commit: 131072 configured tokens/update.",
        "CE is computed in 8192-token chunks before finite-loss testing."
      ]
    },
    {
      "dot": "rose",
      "title": "Persistence limits",
      "items": [
        "Periodic: model, optimizer, scheduler, metadata. Final adds RNG separately.",
        "Latest-complete checks model/optimizer/meta, not scheduler or RNG.",
        "Rollback restores training state, not RNG or loader position."
      ]
    },
    {
      "dot": "slate",
      "title": "Source / configured baseline",
      "items": [
        "Revision 3c9675deaf16",
        "configs/pretrain_a100_502m.yaml",
        "ModelConfig defaults · no CLI overrides"
      ]
    }
  ]
}
