        }
      ]
    },
    {
      "id": "claim_ae14565d00a14095812a2a4495de8871",
      "statement": "`num_parameters()` counts unique parameter objects by ID so tied embedding/output weights are counted once; production configuration therefore reports 501,836,640 total parameters, while the analytical active count includes non-MoE parameters, selected routed and shared experts, and one router per layer while excluding inactive routed experts.",
      "evidence": [
        {
          "resource": "repo://models/transformer.py#L229-L261",
          "version": "repo-lines-v1:sha256:d0f2bfbc7ddff2ca2ed6414a409cad200da8fda36207e632f06b7bc6e8ce8ded:"
