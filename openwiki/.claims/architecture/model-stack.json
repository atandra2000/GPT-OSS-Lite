        }
      ]
    },
    {
      "id": "claim_89e83d69bf3a4781bb4949bfb6a057a1",
      "statement": "YaRN configuration requires positive original and target sequence lengths; `yarn_scale_factor` must be at least one, and a scale factor above one requires the original length to be smaller than the target. Scale one is accepted as the plain-RoPE case.",
      "evidence": [
        {
          "resource": "repo://models/transformer.py#L91-L112",
          "version": "repo-lines-v1:sha256:8237f9dbedfd31ab91415f1478bb08db1104205540583b874e7b383fd40ed5c4:"
