  "claims": [
    {
      "id": "claim_cf7966498166463e8190e263ccadb681",
      "statement": "`ModelConfig` is the typed model-configuration boundary: YAML training startup constructs it from `cfg[\"model\"]` before constructing `GPTOSS`, while training-only settings remain in the separate `training` mapping.",
      "evidence": [
        {
          "resource": "repo://configs/pretrain_a100_502m.yaml#L17-L43",
          "version": "repo-lines-v1:sha256:7366d1428a8c68a7d2a9fda8350f1f403457c130f80a3fdcf133f5379f169f6b:"
        },
        {
