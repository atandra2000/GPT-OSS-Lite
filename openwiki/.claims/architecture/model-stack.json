        }
      ]
    },
    {
      "id": "claim_b332e84eb5544c8aaac792964b7b4abf",
      "statement": "RMSNorm computes detached per-token RMS statistics in FP32, applies a learned bias-free scale, and casts back to the input dtype; the model uses two block norms plus a final norm.",
      "evidence": [
        {
          "resource": "repo://models/transformer.py#L125-L135",
          "version": "repo-lines-v1:sha256:44a5f58853a3119f8d911f3f146526ce7a5f4c6c4d2808931460426ddc5a218e:"
