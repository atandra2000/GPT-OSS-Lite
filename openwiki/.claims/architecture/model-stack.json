        }
      ]
    },
    {
      "id": "claim_0c40240d45b3454d8e39c0731c9e3aab",
      "statement": "With `weight_tying=True`, `GPTOSS` assigns `head.weight` to `embed.weight`, making the embedding and output projection share one parameter object; `weight_tying=False` creates separate parameters.",
      "evidence": [
        {
          "resource": "repo://models/transformer.py#L159-L170",
          "version": "repo-lines-v1:sha256:c2cd14f846f76ee7195d7a43465b428210a91203af505b04ab6aeab31168a025:"
