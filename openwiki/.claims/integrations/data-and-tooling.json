        }
      ]
    },
    {
      "id": "claim_c07f5ac19f6742efb755362009a6c5ac",
      "statement": "The data-preparation shim adds the project and parent workspace roots to sys.path, reads universal corpus/tokenizer/shard metadata for an informational banner, and delegates CLI execution to shared_data.prepare_data.main().",
