    {
      "id": "claim_6c1b59eb749e451297708b1ae41f3df6",
      "statement": "For raw shards, PretrainDataset maps uint32, uint16, and uint8 manifest dtypes to torch integer types and derives token counts from file size; it memory-maps raw files with torch.from_file(shared=True), memory-maps saved tensors with torch.load, and caches only the most recently loaded shard.",
      "evidence": [
        {
          "resource": "repo://training/pretrain.py#L113-L153",
          "version": "repo-lines-v1:sha256:6deab95c8511f77e34a1c5db75f693d223478cf3c371d6f407f02fcffd03fb72:"
