    {
      "id": "claim_bcae66979d074b458e34a707fc05e29b",
      "statement": "Each dataset item starts at idx multiplied by max_seq_len, reads max_seq_len plus one contiguous tokens, and returns shifted chunk[:-1] and chunk[1:] tensors for next-token prediction; the sharded slow path concatenates slices from successive shards when the window crosses a boundary.",
      "evidence": [
        {
          "resource": "repo://training/pretrain.py#L155-L196",
          "version": "repo-lines-v1:sha256:ad9b5232b65d14d9793b5e7d2dddf52beba20cc38fc31b7abbe1a1e9d1100ab0:"
