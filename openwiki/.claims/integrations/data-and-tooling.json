    {
      "id": "claim_df06d6ba58a94f9e82db7adf2580057f",
      "statement": "Sharded loader format detection identifies a PK header as torch_save, treats a non-PK file whose size is divisible by four as raw_bytes, and assumes torch_save otherwise; legacy torch.save shard files remain covered by a compatibility test.",
