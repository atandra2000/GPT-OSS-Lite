    {
      "id": "claim_a4f1aee0961e4b34bd0fd076303c8065",
      "statement": "GPT-OSS-Lite owns a thin data-preparation shim and the training-side loader, while the corpus builder, tokenizer, download, cleaning, and packing implementation remains in the sibling external shared_data package; the repository does not contain a vendored shared_data module.",
      "evidence": [
        {
          "resource": "repo://data/prepare_data.py#L1-L30",
          "version": "repo-lines-v1:sha256:4c514baa2f788115d7b28dda74afcf7a38102b23f38465ba30376e1cd09d803a:"
