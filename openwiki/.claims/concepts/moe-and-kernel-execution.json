    },
    {
      "id": "claim_4adf4aa9707148d0bb43a2755626478b",
      "statement": "The `\"stacked\"` dispatcher is the pure-PyTorch reference path: it runs the complete SwiGLU expert on each non-empty expert slice and works without Triton on CPU, Mac, and CUDA. It is the default unless the dispatch setting is exactly `\"triton_grouped\"`.",
      "evidence": [
        {
          "resource": "repo://models/moe.py#L168-L205",
          "version": "repo-lines-v1:sha256:0316cfc425d5e8aad8a820706520bf32b803c561bcca7ef88812af5fcdee1823:"
        },
