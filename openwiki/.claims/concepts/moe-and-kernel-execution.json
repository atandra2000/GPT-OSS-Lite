        }
      ]
    },
    {
      "id": "claim_9c77be6bd01d4a4386fd825a0b5e6743",
      "statement": "Both MoE dispatch paths flatten routing slots, repeat token ids, stably sort by expert id, derive expert counts and offsets, process contiguous per-expert ranges, apply routing weights, and accumulate duplicate token contributions back to the token buffer with `index_add` semantics.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L137-L143",
          "version": "repo-lines-v1:sha256:4afd29be14c4d79b1c07a3cab1d1278ea350c370f50b03d913b3268990346973:"
