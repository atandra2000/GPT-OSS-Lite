        }
      ]
    },
    {
      "id": "claim_534fcb8215494f588404a5bff9b82db9",
      "statement": "The YAML loader safely parses the file, constructs `ModelConfig` from the `model` mapping, keeps `training` and `data` as dictionaries, and applies `--max-steps` by overriding `training.total_steps` in memory; model validation enforces structural invariants such as GQA divisibility, matching `d_model`, valid MoE counts, and valid YaRN lengths.",
      "evidence": [
        {
          "resource": "repo://models/transformer.py#L51-L122",
          "version": "repo-lines-v1:sha256:ee983d1b7424da82cb83c8e2c9d1a277f131064d4f450b31ec54cb3a68f6a21a:"
