  "claims": [
    {
      "id": "claim_3cfe1e4a673443e9a93e92835776fb7a",
      "statement": "`training/pretrain.py` is a single-device raw-PyTorch pretraining entrypoint whose `main` owns seeding, hardware setup, YAML loading, model and optimizer construction, data loading, training, logging, checkpoint recovery, and final persistence; the CLI requires `--config` and supports `--max-steps`, `--seed`, and `--resume-from`.",
      "evidence": [
        {
          "resource": "repo://training/pretrain.py#L1-L5",
          "version": "repo-lines-v1:sha256:0b1e37e5ec2055fc00dcf4302851fdef7147e433d593cb72cd9291e9b2a97dee:"
        },
        {
          "resource": "repo://training/pretrain.py#L229-L257",
