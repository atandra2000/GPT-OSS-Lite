        }
      ]
    },
    {
      "id": "claim_e59aee9cbd244e8e980a15ae2c862da8",
      "statement": "The entrypoint selects `cuda:0` when CUDA is available and CPU otherwise, enables CUDA-specific TF32, cuDNN benchmark, and cuBLASLt settings only when CUDA exists, and invokes `torch.compile` only when both `training.compile` is true and the device is CUDA; compile failure emits a warning and continues uncompiled.",
      "evidence": [
        {
          "resource": "repo://training/pretrain.py#L212-L227",
          "version": "repo-lines-v1:sha256:0ca1f25c2e2ba9ecf8fee7c7ef5becc80cd2b647dad4c7e1a4abb0a0d414f84b:"
