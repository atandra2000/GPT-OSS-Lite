        }
      ]
    },
    {
      "id": "claim_a8020b6ea219419185858f7a85e900bc",
      "statement": "When `--seed` is supplied, initialization seeds Python, NumPy, Torch, and all CUDA generators before model construction and installs `CUBLAS_WORKSPACE_CONFIG=:4096:8` only when that environment variable is absent; without `--seed`, this initialization function is not called and the run is not explicitly reproducible.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L137-L143",
          "version": "repo-lines-v1:sha256:4afd29be14c4d79b1c07a3cab1d1278ea350c370f50b03d913b3268990346973:"
