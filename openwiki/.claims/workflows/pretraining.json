    {
      "id": "claim_ffb62b73839b4b2bb3f1475100178a86",
      "statement": "The implemented backward loss contract is `L = (chunked CE + aux_loss_alpha * mean router loss) / gradient_accumulation_steps`: chunked cross-entropy sums token losses in vocabulary-sized chunks and divides by the total token count, while `GPTOSS` averages router losses across layers before applying `aux_loss_alpha`.",
      "evidence": [
        {
          "resource": "repo://configs/pretrain_a100_502m.yaml#L64-L68",
          "version": "repo-lines-v1:sha256:d0db58d011fff3b02ec6c511fab0c56433d400d6aa302294cb3e5262b50d3ab1:"
