    {
      "id": "claim_469b76746e5743cfa75dcc6d41c5f39e",
      "statement": "Each dataset item is a contiguous `max_seq_len + 1` token window split into `input_ids=chunk[:-1]` and `target_ids=chunk[1:]`; the DataLoader shuffles micro-batches, drops incomplete batches, uses CUDA pinning by default, and keeps workers persistent when workers are enabled.",
      "evidence": [
        {
          "resource": "repo://training/pretrain.py#L158-L161",
          "version": "repo-lines-v1:sha256:5102e71c90059961fe56fad83ef724bd192bd4b14139f9f273c47be258c774dc:"
