    {
      "id": "claim_d8bb1d84fb7749809aebbfa1bedec95e",
      "statement": "The optimizer-step boundary is `micro_step % accum == 0`; only there does the loop clip gradients, call AdamW, advance the scheduler, clear gradients, increment the optimizer `step`, and update progress, logging, and interval-checkpoint decisions.",
      "evidence": [
        {
          "resource": "repo://training/pretrain.py#L398-L428",
          "version": "repo-lines-v1:sha256:31a15e4f8a4c029864a536083e8c19be722136089c5c85ea7dc3bbfeb5fa98bc:"
        }
      ]
    },
    {
      "id": "claim_2255170cb52f4d1fb51ab6e015122b64",
      "statement": "AdamW uses a decayed parameter group and a zero-decay group selected by parameter-name substrings `bias`, `norm`, and `embed`, with configured learning rate, weight decay, betas, hard-coded `eps=1e-6`, foreach updates, and CUDA-only fused updates; its `LambdaLR` performs linear warmup, cosine decay, and a minimum-LR floor once per optimizer step.",
      "evidence": [
        {
          "resource": "repo://configs/pretrain_a100_502m.yaml#L51-L61",
